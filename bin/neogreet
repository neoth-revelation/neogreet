class NeogreetWindow(Gtk.ApplicationWindow):
    def __init__(self, app, is_demo=False):
        super().__init__(application=app, title="neogreet")
        self.is_demo = is_demo

        if self.is_demo:
            self.set_default_size(1280, 720)
            self.set_decorated(True)
            self.set_title("neogreet [DEMO] – Wciśnij ESC aby wyjść")
            # Close cleanly on Escape
            key_ctrl = Gtk.EventControllerKey()
            def on_key_pressed(_c, keyval, _keycode, _state):
                if keyval == Gdk.KEY_Escape:
                    self.get_application().quit()
                    return True
                return False
            key_ctrl.connect("key-pressed", on_key_pressed)
            self.add_controller(key_ctrl)
        else:
            self.set_default_size(1920, 1080)
            self.set_decorated(False)
            self.fullscreen()

        self.client = GreetdClient()
        self.state = load_state()
        self.sessions, self.selected_session = scan_sessions(self.state.get("last_session", ""))

        # Root Overlay
        overlay = Gtk.Overlay()
        self.set_child(overlay)

        # 1. Background Wallpaper
        bg_path = "/usr/share/backgrounds/greeter.png"
        if os.path.exists(bg_path):
            picture = Gtk.Picture.new_for_filename(bg_path)
            picture.set_content_fit(Gtk.ContentFit.COVER)
            overlay.set_child(picture)
        else:
            fallback = Gtk.Box()
            overlay.set_child(fallback)

        # 2. Top-Center Clock Pill
        clock_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        clock_box.set_halign(Gtk.Align.CENTER)
        clock_box.set_valign(Gtk.Align.START)
        self.clock_label = Gtk.Label()
        self.clock_label.add_css_class("clock-pill")
        clock_box.append(self.clock_label)
        overlay.add_overlay(clock_box)
        self.update_clock()
        GLib.timeout_add_seconds(1, self.update_clock)

        # 3. Top-Right Buttons (Reboot, Power Off)
        top_right_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        top_right_box.set_halign(Gtk.Align.END)
        top_right_box.set_valign(Gtk.Align.START)
        top_right_box.set_margin_top(24)
        top_right_box.set_margin_end(28)

        reboot_btn = Gtk.Button.new_from_icon_name("system-reboot-symbolic")
        reboot_btn.add_css_class("circle-btn")
        reboot_btn.set_tooltip_text(tr("reboot_tooltip"))
        reboot_btn.connect("clicked", self.on_reboot)
        top_right_box.append(reboot_btn)

        power_btn = Gtk.Button.new_from_icon_name("system-shutdown-symbolic")
        power_btn.add_css_class("circle-btn")
        power_btn.add_css_class("power-btn")
        power_btn.set_tooltip_text(tr("poweroff_tooltip"))
        power_btn.connect("clicked", self.on_poweroff)
        top_right_box.append(power_btn)

        overlay.add_overlay(top_right_box)

        # 4. Bottom-Left Button (Session Selector)
        bottom_left_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        bottom_left_box.set_halign(Gtk.Align.START)
        bottom_left_box.set_valign(Gtk.Align.END)
        bottom_left_box.set_margin_bottom(24)
        bottom_left_box.set_margin_start(28)

        self.session_btn = Gtk.Button.new_from_icon_name("view-app-grid-symbolic")
        self.session_btn.add_css_class("circle-btn")
        self.session_btn.set_tooltip_text(
            f"{tr('session_prefix')}: {self.selected_session['name'] if self.selected_session else tr('session_none')}"
        )
        self.session_btn.connect("clicked", self.on_session_clicked)
        bottom_left_box.append(self.session_btn)

        # Popover for Session Selection (no arrow, clean floating card)
        self.session_popover = Gtk.Popover()
        self.session_popover.set_has_arrow(False)
        self.session_popover.set_parent(self.session_btn)
        self.session_popover.set_position(Gtk.PositionType.TOP)
        self.build_session_menu()

        overlay.add_overlay(bottom_left_box)

        # 5. Center Login Card
        center_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        center_container.set_halign(Gtk.Align.CENTER)
        center_container.set_valign(Gtk.Align.CENTER)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        card.add_css_class("login-card")
        center_container.append(card)

        # Username Field (with icon inside)
        self.user_entry = Gtk.Entry()
        self.user_entry.set_icon_from_icon_name(Gtk.EntryIconPosition.PRIMARY, "avatar-default-symbolic")
        self.user_entry.set_text(self.state.get("last_user", ""))
        self.user_entry.set_placeholder_text(tr("user_placeholder"))
        self.user_entry.connect("activate", lambda _: self.pass_entry.grab_focus())
        card.append(self.user_entry)

        # Password Field (with key icon inside & peek toggle)
        self.pass_entry = Gtk.Entry()
        self.pass_entry.set_visibility(False)
        self.pass_entry.set_icon_from_icon_name(Gtk.EntryIconPosition.PRIMARY, "dialog-password-symbolic")
        self.pass_entry.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, "view-reveal-symbolic")
        self.pass_entry.set_icon_activatable(Gtk.EntryIconPosition.SECONDARY, True)
        self.pass_entry.connect("icon-press", self.on_password_peek_toggle)
        self.pass_entry.set_placeholder_text(tr("password_placeholder"))
        self.pass_entry.connect("activate", lambda _: self.on_login())
        card.append(self.pass_entry)

        # Error / Status Label
        self.status_label = Gtk.Label()
        self.status_label.add_css_class("error-label")
        self.status_label.set_visible(False)
        card.append(self.status_label)

        # Login Button
        self.login_btn = Gtk.Button(label=tr("login_btn"))
        self.login_btn.add_css_class("login-btn")
        self.login_btn.set_hexpand(True)
        self.login_btn.connect("clicked", lambda _: self.on_login())
        card.append(self.login_btn)

        overlay.add_overlay(center_container)

        # Auto-focus password entry cleanly
        def _focus_pass_entry():
            self.pass_entry.grab_focus()
            return GLib.SOURCE_REMOVE
        GLib.idle_add(_focus_pass_entry)

    def update_clock(self):
        now = datetime.now()
        date_str = now.strftime("%A, %d %B %H:%M")
        self.clock_label.set_text(date_str.capitalize())
        return GLib.SOURCE_CONTINUE

    def on_password_peek_toggle(self, entry, icon_pos):
        if icon_pos == Gtk.EntryIconPosition.SECONDARY:
            current_vis = entry.get_visibility()
            entry.set_visibility(not current_vis)
            entry.set_icon_from_icon_name(
                Gtk.EntryIconPosition.SECONDARY,
                "view-conceal-symbolic" if not current_vis else "view-reveal-symbolic"
            )

    def on_reboot(self, _btn):
        if self.is_demo:
            self.show_error(tr("demo_reboot"))
            return
        os.system("systemctl reboot -i")

    def on_poweroff(self, _btn):
        if self.is_demo:
            self.show_error(tr("demo_poweroff"))
            return
        os.system("systemctl poweroff -i")

    def on_session_clicked(self, _btn):
        self.session_popover.popup()

    def build_session_menu(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        for s in self.sessions:
            btn = Gtk.Button(label=s["name"])
            btn.add_css_class("session-row")
            if self.selected_session and s["name"] == self.selected_session["name"]:
                btn.add_css_class("active")

            def make_handler(sess):
                def handler(_):
                    self.selected_session = sess
                    self.session_btn.set_tooltip_text(f"{tr('session_prefix')}: {sess['name']}")
                    save_state(self.user_entry.get_text().strip(), sess["name"])
                    self.build_session_menu()
                    self.session_popover.popdown()
                return handler

            btn.connect("clicked", make_handler(s))
            vbox.append(btn)
        self.session_popover.set_child(vbox)

    def on_login(self):
        username = self.user_entry.get_text().strip()
        password = self.pass_entry.get_text()

        if not username:
            self.show_error(tr("enter_username"))
            self.user_entry.grab_focus()
            return

        self.login_btn.set_sensitive(False)
        self.status_label.set_text(tr("logging_in"))
        self.status_label.set_visible(True)

        cmd = self.selected_session["cmd"] if self.selected_session else ["Hyprland"]

        def worker():
            res = self.client.login(username, password, cmd)
            GLib.idle_add(self._on_login_result, username, res)

        threading.Thread(target=worker, daemon=True).start()

    def _on_login_result(self, username, res):
        if res.get("type") == "success":
            save_state(username, self.selected_session["name"] if self.selected_session else "")
            if self.is_demo:
                self.status_label.set_text(tr("login_success_demo"))
                self.status_label.set_visible(True)
                GLib.timeout_add(1000, lambda: (self.get_application().quit(), GLib.SOURCE_REMOVE)[1])
            else:
                self.get_application().quit()
        else:
            err_desc = res.get("description") or tr("login_failed")
            if res.get("error_type") == "auth_error":
                err_desc = tr("invalid_password")
            self.show_error(err_desc)
            self.login_btn.set_sensitive(True)
            self.pass_entry.set_text("")
            self.pass_entry.grab_focus()
        return GLib.SOURCE_REMOVE

    def show_error(self, message):
        self.status_label.set_text(message)
        self.status_label.set_visible(True)


class NeogreetApp(Gtk.Application):
    def __init__(self, is_demo=False):
        super().__init__(application_id="apps.neoth.neogreet")
        self.is_demo = is_demo

    def do_activate(self):
        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(CSS_DATA)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        win = NeogreetWindow(self, is_demo=self.is_demo)
        win.present()


if __name__ == "__main__":
    is_demo = False
    filtered_argv = [sys.argv[0]]
    for arg in sys.argv[1:]:
        if arg in ("--demo", "-d"):
            is_demo = True
            os.environ["NEOGREET_DEMO"] = "1"
        elif arg in ("--help", "-h"):
            if CURRENT_LANG == "pl":
                print("Użycie: neogreet [OPCJE]")
                print("Opcje:")
                print("  -d, --demo    Uruchamia greeter w oknie testowym (bez połączenia z greetd)")
                print("  -h, --help    Wyświetla pomoc")
            else:
                print("Usage: neogreet [OPTIONS]")
                print("Options:")
                print("  -d, --demo    Launch greeter in a floating test window (without greetd connection)")
                print("  -h, --help    Display this help message")
            sys.exit(0)
        else:
            filtered_argv.append(arg)

    app = NeogreetApp(is_demo=is_demo)
    app.run(filtered_argv)
