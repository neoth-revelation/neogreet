def detect_language():
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        val = os.environ.get(var)
        if val:
            code = val.split(".")[0].split("_")[0].lower()
            if code in TRANSLATIONS:
                return code
    try:
        loc = locale.getlocale(locale.LC_MESSAGES)[0]
        if loc:
            code = loc.split("_")[0].lower()
            if code in TRANSLATIONS:
                return code
    except Exception:
        pass
    return "en"


CURRENT_LANG = detect_language()


def tr(key):
    lang_dict = TRANSLATIONS.get(CURRENT_LANG, TRANSLATIONS["en"])
    return lang_dict.get(key, TRANSLATIONS["en"].get(key, key))


STATE_FILE = os.path.expanduser("~/.cache/neogreet/state.json")


def load_state():
    try:
        if os.path.exists(STATE_FILE):
            with open(STATE_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
    except Exception:
        pass
    return {"last_user": "", "last_session": "Hyprland (uwsm-managed)"}


def save_state(user, session_name):
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        with open(STATE_FILE, "w", encoding="utf-8") as f:
            json.dump({"last_user": user, "last_session": session_name}, f)
    except Exception:
        pass


class GreetdClient:
    def __init__(self):
        sock_path = os.environ.get("GREETD_SOCK")
        self.sock = None
        if sock_path and os.path.exists(sock_path):
            try:
                self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                self.sock.connect(sock_path)
            except Exception as e:
                print(f"Failed to connect to greetd socket: {e}", file=sys.stderr)
                self.sock = None

    def _recv_exact(self, n):
        buf = bytearray()
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                return None
            buf.extend(chunk)
        return bytes(buf)

    def _send(self, payload):
        if not self.sock:
            return {"type": "success"}
        try:
            data = json.dumps(payload).encode("utf-8")
            self.sock.sendall(struct.pack("=I", len(data)) + data)
            resp_len_bytes = self._recv_exact(4)
            if resp_len_bytes is None:
                return {"type": "error", "description": "Socket closed"}
            resp_len = struct.unpack("=I", resp_len_bytes)[0]
            resp_data = self._recv_exact(resp_len)
            if resp_data is None:
                return {"type": "error", "description": "Socket closed"}
            return json.loads(resp_data.decode("utf-8"))
        except Exception as e:
            return {"type": "error", "description": str(e)}

    def login(self, username, password, cmd):
        if not self.sock:
            if os.environ.get("NEOGREET_DEMO") == "1" or os.environ.get("ANTIGRAVITY_GREETER_DEMO") == "1":
                print(f"[DEMO] Login attempt: user={username}, cmd={cmd}")
                if password == "wrong":
                    return {"type": "error", "error_type": "auth_error", "description": tr("invalid_password")}
                return {"type": "success"}
            return {"type": "error", "error_type": "error", "description": tr("no_greetd_conn")}

        # 1. Create session
        res = self._send({"type": "create_session", "username": username})
        while res.get("type") == "auth_message":
            msg_type = res.get("auth_message_type")
            if msg_type == "secret":
                res = self._send({"type": "post_auth_message_response", "response": password})
            elif msg_type == "visible":
                res = self._send({"type": "post_auth_message_response", "response": username})
            else:
                res = self._send({"type": "post_auth_message_response"})

        if res.get("type") == "success":
            # 2. Start session
            start_res = self._send({
                "type": "start_session",
                "cmd": cmd,
                "env": []
            })
            return start_res
        else:
            # Reset greetd transaction on failure
            self._send({"type": "cancel_session"})
            return res


def scan_sessions(last_session_name=""):
    sessions = []
    selected_session = None
    search_paths = ["/usr/share/wayland-sessions", "/usr/share/xsessions"]
    seen_names = set()

    for p in search_paths:
        for f in sorted(glob.glob(os.path.join(p, "*.desktop"))):
            name = None
            cmd = None
            try:
                with open(f, "r", encoding="utf-8") as df:
                    for line in df:
                        line = line.strip()
                        if line.startswith("Name=") and not name:
                            name = line.split("=", 1)[1]
                        elif line.startswith("Exec=") and not cmd:
                            cmd_str = line.split("=", 1)[1]
                            cmd = shlex.split(cmd_str)
                if name and cmd and name not in seen_names:
                    seen_names.add(name)
                    item = {"name": name, "cmd": cmd, "file": f}
                    sessions.append(item)
                    if last_session_name and name == last_session_name:
                        selected_session = item
                    elif not selected_session and "uwsm" in name.lower():
                        selected_session = item
            except Exception:
                continue

    if not selected_session and sessions:
        selected_session = sessions[0]
    return sessions, selected_session


