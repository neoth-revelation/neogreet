def detect_language():
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        val = os.environ.get(var)
        if val:
            code = val.split(".")[0].split("_")[0].lower()
            return code if code in TRANSLATIONS else "en"
    try:
        loc = locale.getlocale(locale.LC_MESSAGES)[0]
        if loc:
            code = loc.split("_")[0].lower()
            if code in TRANSLATIONS:
                return code
    except Exception:
        pass
    return "en"


CURRENT_LANG = detect_language()


def tr(key):
    lang_dict = TRANSLATIONS.get(CURRENT_LANG, TRANSLATIONS["en"])
    return lang_dict.get(key, TRANSLATIONS["en"].get(key, key))


STATE_FILE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
                          "neogreet", "state.json")
LOG = logging.getLogger("neogreet")


def load_state():
    try:
        if os.path.exists(STATE_FILE):
            with open(STATE_FILE, "r", encoding="utf-8") as f:
                state = json.load(f)
                if not isinstance(state, dict) or any(
                    not isinstance(state.get(key, ""), str)
                    for key in ("last_user", "last_session")
                ):
                    raise ValueError("Invalid state structure")
                return state
    except (OSError, ValueError):
        LOG.warning("Cannot read state; using defaults")
    return {"last_user": "", "last_session": "Hyprland (uwsm-managed)"}


def save_state(user, session_name):
    temporary = None
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8",
                                         dir=os.path.dirname(STATE_FILE), delete=False) as f:
            temporary = f.name
            json.dump({"last_user": user, "last_session": session_name}, f)
        os.replace(temporary, STATE_FILE)
    except OSError:
        LOG.warning("Cannot save state; check greeter cache permissions")
    finally:
        if temporary and os.path.exists(temporary):
            try:
                os.unlink(temporary)
            except OSError:
                LOG.warning("Cannot remove temporary state file")


def load_config(path):
    config = {"wallpaper": "/usr/share/backgrounds/greeter.png",
              "clock_format": "%A, %d %B %H:%M", "css": ""}
    parser = configparser.ConfigParser(interpolation=None)
    try:
        with open(path, encoding="utf-8") as stream:
            parser.read_file(stream)
        if parser.has_section("appearance"):
            config.update({key: parser.get("appearance", key, fallback=value)
                           for key, value in config.items()})
    except FileNotFoundError:
        pass
    except (OSError, configparser.Error):
        LOG.warning("Cannot read configuration; using defaults")
    return config


class GreetdClient:
    MAX_MESSAGE = 1024 * 1024

    def __init__(self, is_demo=False):
        self.is_demo = is_demo
        self.sock = None
        self.needs_reset = False

    def close(self):
        if self.sock is not None:
            self.sock.close()
            self.sock = None

    def _connect(self):
        sock_path = os.environ.get("GREETD_SOCK")
        if not sock_path:
            raise OSError(tr("no_greetd_conn"))
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(60)
        self.sock.connect(sock_path)

    def _recv_exact(self, n):
        buf = bytearray()
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                return None
            buf.extend(chunk)
        return bytes(buf)

    def request(self, payload):
        # Demo is explicit and never opens a socket, even if GREETD_SOCK exists.
        if self.is_demo:
            if payload["type"] == "create_session":
                return {"type": "auth_message", "auth_message_type": "secret",
                        "auth_message": tr("password_placeholder")}
            if payload.get("response") == "wrong":
                return {"type": "error", "error_type": "auth_error",
                        "description": tr("invalid_password")}
            return {"type": "success"}
        try:
            if self.sock is None:
                self._connect()
            if payload["type"] == "create_session" and self.needs_reset:
                cleanup = self.request({"type": "cancel_session"})
                if cleanup["type"] != "success":
                    return cleanup
                self.needs_reset = False
            data = json.dumps(payload).encode("utf-8")
            self.sock.sendall(struct.pack("=I", len(data)) + data)
            resp_len_bytes = self._recv_exact(4)
            if resp_len_bytes is None:
                raise OSError("Socket closed")
            resp_len = struct.unpack("=I", resp_len_bytes)[0]
            if not 0 < resp_len <= self.MAX_MESSAGE:
                raise ValueError("Invalid greetd message length")
            resp_data = self._recv_exact(resp_len)
            if resp_data is None:
                raise OSError("Socket closed")
            result = json.loads(resp_data.decode("utf-8"))
            if not isinstance(result, dict) or result.get("type") not in (
                "success", "error", "auth_message"
            ):
                raise ValueError("Invalid greetd response")
            if result["type"] == "auth_message" and (
                result.get("auth_message_type") not in ("secret", "visible", "info", "error")
                or not isinstance(result.get("auth_message"), str)
            ):
                raise ValueError("Invalid authentication message")
            if result["type"] == "error":
                if not isinstance(result.get("description", ""), str):
                    raise ValueError("Invalid error description")
                self.needs_reset = True
            return result
        except (OSError, ValueError, UnicodeError):
            self.close()
            self.needs_reset = True
            LOG.warning("greetd communication failed (details omitted to protect credentials)")
            return {"type": "error", "description": tr("no_greetd_conn")}


def session_command(value, name, filename, icon=""):
    # Desktop Entry escaping is applied before Exec tokenization.
    escapes = {"s": " ", "n": "\n", "t": "\t", "r": "\r", "\\": "\\"}
    unescaped = []
    i = 0
    while i < len(value):
        if value[i] == "\\" and i + 1 < len(value) and value[i + 1] in escapes:
            i += 1
            unescaped.append(escapes[value[i]])
        else:
            unescaped.append(value[i])
        i += 1
    lexer = shlex.shlex("".join(unescaped), posix=True)
    lexer.whitespace_split = True
    lexer.commenters = ""
    lexer.quotes = '"'
    command = []
    for token in lexer:
        if token in ("%f", "%F", "%u", "%U", "%d", "%D", "%n", "%N", "%v", "%m"):
            continue
        if token == "%i":
            if icon:
                command.extend(["--icon", icon])
            continue
        expanded = []
        i = 0
        while i < len(token):
            if token[i] == "%":
                i += 1
                if i == len(token) or token[i] not in ("%", "c", "k"):
                    raise ValueError("Unsupported Exec field code")
                expanded.append({"%": "%", "c": name, "k": filename}[token[i]])
            else:
                expanded.append(token[i])
            i += 1
        command.append("".join(expanded))
    if not command or not command[0]:
        raise ValueError("Empty Exec command")
    return command


def scan_sessions(last_session_name="", search_paths=None):
    sessions = []
    selected_session = None
    # Starting an X11 .desktop Exec directly does not start an X server.
    # Only advertise sessions we can actually launch.
    if search_paths is None:
        roots = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
        search_paths = [os.path.join(root, "wayland-sessions") for root in roots if root]
    seen_ids = set()

    for p in search_paths:
        for f in sorted(glob.glob(os.path.join(p, "*.desktop"))):
            session_id = os.path.basename(f)
            if session_id in seen_ids:
                continue
            seen_ids.add(session_id)
            try:
                parser = configparser.ConfigParser(interpolation=None, strict=False)
                parser.optionxform = str
                with open(f, "r", encoding="utf-8") as df:
                    parser.read_file(df)
                entry = parser["Desktop Entry"]
                if entry.getboolean("Hidden", False) or entry.getboolean("NoDisplay", False):
                    continue
                if entry.get("Type", "Application") != "Application" or entry.getboolean("Terminal", False):
                    continue
                if entry.get("TryExec") and not shutil.which(entry["TryExec"]):
                    continue
                name = entry.get(f"Name[{CURRENT_LANG}]", entry.get("Name", ""))
                cmd = session_command(entry["Exec"], name, f, entry.get("Icon", ""))
                if name:
                    item = {"name": name, "cmd": cmd, "file": f, "id": session_id}
                    sessions.append(item)
                    if last_session_name in (session_id, name):
                        selected_session = item
                    elif not selected_session and "uwsm" in name.lower():
                        selected_session = item
            except (OSError, UnicodeError, ValueError, KeyError, configparser.Error):
                LOG.warning("Skipping invalid session file: %s", f)
                continue

    if not selected_session and sessions:
        selected_session = sessions[0]
    return sessions, selected_session


